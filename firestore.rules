
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /homeworks/{id} { allow read, write: if request.auth.uid == userId; }
      match /quickNotes/{id} { allow read, write: if request.auth.uid == userId; }
      match /statistics/{id} { allow read, write: if request.auth.uid == userId; }
      match /presentations/{id} { allow read, write: if request.auth.uid == userId; }
      match /documents/{id} { 
        allow read: if (resource != null && resource.data.isPublished == true) || request.auth.uid == userId; 
        allow write: if request.auth.uid == userId; 
      }
      match /todoLists/{id} { allow read, write: if request.auth.uid == userId; }
      match /quizzes/{id} { 
        allow read: if (resource != null && resource.data.isPublished == true) || request.auth.uid == userId;
        allow write: if request.auth.uid == userId; 
        
        match /responses/{responseId} {
          // Nur der Besitzer des Quizzes darf alle Antworten sehen oder löschen
          allow read, delete: if request.auth != null && request.auth.uid == userId;
          // Jeder darf eine Antwort erstellen (um am Quiz teilzunehmen)
          allow create: if true;
          // Aktualisierungen sind dem Besitzer vorbehalten (falls nötig)
          allow update: if request.auth != null && request.auth.uid == userId;
        }
      }
    }
    
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }
  }
}
