
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user has an 'admin' role in their profile.
    function isAdmin() {
      // Use get() to read the user's own profile document from the users collection.
      // The path() function creates the correct path to the document.
      // request.auth.uid is the UID of the currently authenticated user.
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      // Allow a user to read and write their own document.
      // Allow admins to read any user document.
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;

      match /homeworks/{homeworkId} {
        // Allow a user to manage only their own homework tasks.
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
