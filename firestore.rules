
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /homeworks/{id} { allow read, write: if request.auth.uid == userId; }
      match /quickNotes/{id} { allow read, write: if request.auth.uid == userId; }
      match /documents/{id} { allow read: if resource.data.isPublished == true || request.auth.uid == userId; allow write: if request.auth.uid == userId; }
      match /statistics/{id} { allow read, write: if request.auth.uid == userId; }
    }
  }
}
