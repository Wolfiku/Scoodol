{
  "entities": {
    "Subject": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Subject",
      "type": "object",
      "description": "Represents a school subject with its associated details.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the subject."
        },
        "name": {
          "type": "string",
          "description": "Name of the subject (e.g., Math, English)."
        },
        "room": {
          "type": "string",
          "description": "The room where the subject is taught."
        },
        "teacher": {
          "type": "string",
          "description": "Name of the teacher for the subject."
        },
        "startTime": {
          "type": "string",
          "description": "Start time of the subject (e.g., 08:00).",
          "format": "string"
        },
        "endTime": {
          "type": "string",
          "description": "End time of the subject (e.g., 09:00).",
          "format": "string"
        },
        "isMainSubject": {
          "type": "boolean",
          "description": "Indicates whether the subject is a main subject."
        },
        "notes": {
          "type": "string",
          "description": "Additional notes or information about the subject."
        },
        "materialsLink": {
          "type": "string",
          "description": "Link to online materials for the subject.",
          "format": "uri"
        }
      },
      "required": [
        "id",
        "name",
        "room",
        "teacher",
        "startTime",
        "endTime",
        "isMainSubject"
      ]
    },
    "Homework": {
      "title": "Homework",
      "type": "object",
      "description": "A single homework task.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the homework task."
        },
        "subject": {
          "type": "string",
          "description": "The subject of the homework."
        },
        "task": {
          "type": "string",
          "description": "The description of the task."
        },
        "dueDate": {
          "type": "string",
          "format": "date",
          "description": "The due date for the task."
        },
        "done": {
          "type": "boolean",
          "description": "Whether the task is completed."
        },
        "completedAt": {
          "type": "number",
          "description": "Timestamp when the task was marked as done."
        }
      },
      "required": ["id", "task", "done"]
    },
    "UserProfile": {
      "title": "User Profile",
      "type": "object",
      "description": "Stores user-specific application data like timetable and settings.",
      "properties": {
        "email": {
          "type": "string",
          "format": "email"
        },
        "timetable": {
          "type": "object",
          "description": "The user's timetable data."
        },
        "timetableSettings": {
          "type": "object",
          "description": "Settings for the user's timetable."
        },
        "settings": {
          "type": "object",
          "properties": {
            "theme": { "type": "string" },
            "startView": { "type": "string" },
            "aiLanguage": { "type": "string" },
            "betaFeaturesEnabled": { "type": "boolean" },
            "profilePicture": { "type": "string", "format": "uri" }
          }
        }
      }
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "schema": { "$ref": "#/entities/UserProfile" },
          "description": "Stores user profile data. The userId is the document ID."
        }
      },
      {
        "path": "/users/{userId}/homeworks/{homeworkId}",
        "definition": {
          "schema": { "$ref": "#/entities/Homework" },
          "description": "Stores homework tasks for a specific user."
        }
      }
    ]
  }
}
