
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string" },
        "groupId": { "type": "string" },
        "storageUsage": { "type": "number", "description": "Total bytes used for uploaded media files" },
        "groupSettings": {
          "type": "object",
          "properties": {
            "syncTimetable": { "type": "boolean" },
            "showInGroup": { "type": "boolean" },
            "shareHomework": { "type": "boolean" }
          }
        },
        "settings": {
          "type": "object",
          "properties": {
            "theme": { "type": "string" },
            "startView": { "type": "string" },
            "aiLanguage": { "type": "string" },
            "notesSlots": { "type": "object", "additionalProperties": { "type": "string" } },
            "deletedGroupHwIds": { "type": "array", "items": { "type": "string" } }
          }
        },
        "timetable": { "type": "object" },
        "timetableSettings": { "type": "object" }
      }
    },
    "Group": {
      "title": "Group",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "schoolName": { "type": "string" },
        "motto": { "type": "string" },
        "admin": { "type": "string" },
        "members": { "type": "array", "items": { "type": "string" } },
        "roles": { 
          "type": "object", 
          "additionalProperties": { 
            "type": "string", 
            "enum": ["admin", "bearbeiter", "berechtigt", "nutzer"] 
          } 
        },
        "timetable": { "type": "object" },
        "timetableSettings": { "type": "object" }
      },
      "required": ["name", "schoolName", "admin", "members"]
    },
    "Homework": {
      "title": "Homework",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "subject": { "type": "string" },
        "task": { "type": "string" },
        "dueDate": { "type": "string", "format": "date" },
        "done": { "type": "boolean" },
        "completedAt": { "type": "number" },
        "createdBy": { "type": "string" },
        "groupHwId": { "type": "string" }
      },
      "required": ["id", "task", "done"]
    },
    "QuickNote": {
      "title": "Quick Note",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" },
        "isLocked": { "type": "boolean" }
      },
      "required": ["title", "ownerId"]
    },
    "TextDocument": {
      "title": "Text Document",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "ownerId": { "type": "string" },
        "isPublished": { "type": "boolean" },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" }
      },
      "required": ["title", "ownerId"]
    },
    "TodoList": {
      "title": "To-Do List",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "tasks": { "type": "array" },
        "settings": { "type": "object" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" }
      },
      "required": ["title", "ownerId"]
    },
    "Quiz": {
      "title": "Quiz",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "creator": { "type": "string" },
        "slides": { "type": "array" },
        "ownerId": { "type": "string" },
        "isPublished": { "type": "boolean" },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" }
      },
      "required": ["title", "ownerId"]
    },
    "QuizResponse": {
      "title": "Quiz Response",
      "type": "object",
      "properties": {
        "userName": { "type": "string" },
        "answers": { "type": "object" },
        "percentage": { "type": "number" },
        "rating": { "type": "string", "enum": ["sad", "neutral", "happy"] },
        "completedAt": { "type": "object" }
      },
      "required": ["userName", "answers", "percentage", "completedAt"]
    },
    "Statistic": {
      "title": "Statistic",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "ownerId": { "type": "string" },
        "mode": { "type": "string", "enum": ["simple", "complex", "fast"] },
        "charts": { "type": "array" },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" }
      },
      "required": ["title", "ownerId"]
    },
    "Presentation": {
      "title": "Presentation",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "ownerId": { "type": "string" },
        "slides": { "type": "array" },
        "theme": { "type": "string" },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" }
      },
      "required": ["title", "ownerId"]
    }
  },
  "auth": { "providers": ["password", "anonymous"] },
  "firestore": {
    "/users/{userId}": { "schema": { "$ref": "#/entities/UserProfile" }, "description": "User profile" },
    "/users/{userId}/homeworks/{hwId}": { "schema": { "$ref": "#/entities/Homework" }, "description": "Homework" },
    "/users/{userId}/quickNotes/{noteId}": { "schema": { "$ref": "#/entities/QuickNote" }, "description": "Notes" },
    "/users/{userId}/documents/{docId}": { "schema": { "$ref": "#/entities/TextDocument" }, "description": "Docs" },
    "/users/{userId}/todoLists/{listId}": { "schema": { "$ref": "#/entities/TodoList" }, "description": "To-Do Lists" },
    "/users/{userId}/quizzes/{quizId}": { "schema": { "$ref": "#/entities/Quiz" }, "description": "Quizzes" },
    "/users/{userId}/quizzes/{quizId}/responses/{responseId}": { "schema": { "$ref": "#/entities/QuizResponse" }, "description": "Quiz submissions" },
    "/users/{userId}/statistics/{statId}": { "schema": { "$ref": "#/entities/Statistic" }, "description": "Data visualizations" },
    "/users/{userId}/presentations/{presId}": { "schema": { "$ref": "#/entities/Presentation" }, "description": "Presentations" },
    "/groups/{groupId}": { "schema": { "$ref": "#/entities/Group" }, "description": "Group data" },
    "/groups/{groupId}/homeworks/{hwId}": { "schema": { "$ref": "#/entities/Homework" }, "description": "Shared group homework" }
  }
}
